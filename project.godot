; Engine configuration file.
; 小柯機器人眼動探險島

config_version=5

[application]

config/name="小柯機器人眼動探險島"
config/description="給 3～10 歲孩子的 3D 眼動視知覺遊戲：搭配眼動鼠，用眼睛看就能玩，五大主題 30 關與眼動評估報告"
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.53, 0.8, 0.96, 1)
boot_splash/show_image=false
config/quit_on_go_back=false
config/windows_native_icon="res://platform/icon.ico"

[autoload]

Game="*res://scripts/game.gd"
Gaze="*res://scripts/gaze.gd"
Snd="*res://scripts/snd.gd"
Updater="*res://scripts/updater.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/ui_font.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
